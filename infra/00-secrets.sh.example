#!/bin/bash
# ============================================================
# Copy this file to 00-secrets.sh and fill in real values.
# 00-secrets.sh is git-ignored — it will NEVER be pushed to
# GitHub, even though this .example file is.
#
# You'll need to recreate 00-secrets.sh each time you start a
# fresh Sandbox session (the Sandbox wipes the filesystem too,
# not just AWS resources) — same effort as filling in a form,
# just do it in the IDE terminal before running the other scripts.
# ============================================================

# RDS password: 8-41 characters, no '/', '@', '"', or spaces
export DB_PASSWORD="ChangeThisPassword123"

# Your real Gemini API key from aistudio.google.com
export GEMINI_API_KEY="your-gemini-key-here"
